{
  "datasets": [
    {
      "name": "ds_ocupacao",
      "displayName": "Ocupação do município",
      "queryLines": [
        "SELECT municipio, ano, domicilios_ocupados, domicilios_vagos, domicilios_uso_ocasional, ",
        "domicilios_total, pct_vagos / 100.0 AS taxa_vagos ",
        "FROM ocupacao_municipio"
      ]
    },
    {
      "name": "ds_composicao",
      "displayName": "Composição dos domicílios",
      "queryLines": [
        "SELECT 'Ocupados' AS tipo, domicilios_ocupados AS qtd FROM ocupacao_municipio ",
        "UNION ALL SELECT 'Vagos', domicilios_vagos FROM ocupacao_municipio ",
        "UNION ALL SELECT 'Uso ocasional', domicilios_uso_ocasional FROM ocupacao_municipio"
      ]
    },
    {
      "name": "ds_pop_rua",
      "displayName": "Pessoas em situação de rua por ano",
      "queryLines": [
        "SELECT CAST(ano AS STRING) AS ano, qtd_pop_rua ",
        "FROM pop_rua_serie ",
        "ORDER BY ano"
      ]
    },
    {
      "name": "ds_indicadores",
      "displayName": "Indicadores por ano",
      "queryLines": [
        "SELECT CAST(ano_cadunico AS STRING) AS ano_cadunico, qtd_pop_rua, defasagem_anos, ",
        "domicilios_vagos, domicilios_uso_ocasional, ",
        "vagos_por_pessoa_em_situacao_de_rua AS vagos_por_pessoa ",
        "FROM indicadores_municipio ",
        "ORDER BY ano_cadunico"
      ]
    }
  ],
  "pages": [
    {
